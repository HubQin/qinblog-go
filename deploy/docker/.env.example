# docker compose 部署配置：cp .env.example .env 后按需修改
# 该文件既作为 app 容器的环境变量（env_file），也用于 compose 变量插值（MySQL 初始化、端口）

# ---- 应用 ----
APP_NAME=QinBlog
# 用于签名邮箱验证/密码重置链接与 session，务必改成随机长字符串
APP_KEY=please-change-me-to-a-random-string
# 对外访问地址（反向代理时填写真实域名，如 https://blog.example.com）
APP_URL=http://localhost:8080
# 宿主机映射端口（容器内固定 8080）
APP_HOST_PORT=8080

# ---- MySQL ----
# DB_DATABASE/DB_USERNAME/DB_PASSWORD 同时用于初始化 mysql 容器和应用连接
DB_DATABASE=qinblog
DB_USERNAME=qinblog
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret
# 宿主机映射端口，仅用于本机连库调试（避开开发环境的 3306/3307）
MYSQL_HOST_PORT=3308

# ---- Redis ----
# 容器网络内免密访问，故不设 REDIS_PASSWORD
REDIS_HOST_PORT=6381

# ---- 邮件（注册验证 / 找回密码，留空则跳过发信）----
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=QinBlog

# ---- GitHub OAuth 登录（留空则不启用）----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

# ---- 百度翻译（slug 自动翻译，留空回退拼音）----
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_KEY=
