# ============================================================
# QinBlog 应用环境变量模板（不含任何真实密钥，可入库）
# 用法：cp qinblog.env.example qinblog.env，然后修改密码/密钥
# qinblog.env 已被 .gitignore 排除，不会入库
# 注意：env_file 内的值不支持 ${} 插值，DB_PASSWORD 须为实际密码
# ============================================================

# ---- 应用 ----
APP_ENV=production
APP_NAME=QinBlog
# 签名密钥：务必改为随机长字符串（如 openssl rand -base64 32 生成），上线后勿随意更换
APP_KEY=please-change-me-to-a-random-string
# 对外访问地址（nginx 反代域名或 http://IP:8080），影响邮件链接与 session cookie
APP_URL=http://your-domain.example.com
VITE_DEV=false

# ---- 复用共享 mysql/redis（服务名直连，无端口映射） ----
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=qinblog
DB_USERNAME=root
# 填写 MySQL root 实际密码（与 .env 中 DB_ROOT_PASSWORD 保持一致）
DB_PASSWORD=please-change-me
REDIS_HOST=redis
REDIS_PORT=6379
# 若 redis.conf 设置了 requirepass，请在此填写实际密码
REDIS_PASSWORD=please-change-me
REDIS_DB=0

# ---- 全文索引与上传目录（容器内路径，对应命名卷 qinblog-storage） ----
BLEVE_INDEX_PATH=/app/storage/bleve/posts.bleve
UPLOAD_PATH=/app/storage/app/public

# ---- 邮件（留空则跳过发信） ----
# MAIL_HOST=
# MAIL_PORT=25
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME=QinBlog

# ---- GitHub OAuth（留空则不启用） ----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=

# ---- 百度翻译（slug 自动翻译，留空回退拼音） ----
# BAIDU_TRANSLATE_APPID=
# BAIDU_TRANSLATE_KEY=
