# 应用
APP_NAME=QinBlog
APP_ENV=production
# 用于签名邮箱验证/密码重置链接，务必修改为随机长字符串
APP_KEY=please-change-me-to-a-random-string
APP_URL=http://localhost:8080
APP_PORT=8080

# 前端：开发时设 VITE_DEV=true 并运行 cd web && npm run dev
VITE_DEV=false
VITE_DEV_URL=http://localhost:5173

# MySQL（沿用 Laravel 项目的库表）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qinblog
DB_USERNAME=root
DB_PASSWORD=

# Redis（session / 浏览量计数 / 侧边栏缓存）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 邮件（注册验证 / 找回密码）
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=QinBlog

# GitHub OAuth 登录（留空则不启用）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

# 百度翻译（slug 自动翻译，留空回退拼音）
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_KEY=

# 全文索引与上传目录
BLEVE_INDEX_PATH=storage/bleve/posts.bleve
UPLOAD_PATH=storage/app/public
