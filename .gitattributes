# 仓库内统一使用 LF，避免 Windows 开发 / Linux 部署的换行差异
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zap binary
*.bolt binary
*.exe binary

# GitHub 语言统计忽略生成物 / 前端依赖
web/public/build/** linguist-generated=true
web/node_modules/** linguist-vendored=true
